  "parsing_strategy": {
    "approach": "incremental",
    "description": "Парсим источники в порядке приоритета, сохраняя прогресс",
    "steps": [
      {
        "step": 1,
        "name": "Critical sources first",
        "sources": ["gk_rk_contracts", "tk_rk"],
        "reason": "Наиболее часто используемые в анализе"
      },
      {
        "step": 2,
        "name": "High priority",
        "sources": ["gk_rk_general", "judicial_practice_vs", "normative_resolutions"],
        "reason": "Расширяют контекст анализа"
      },
      {
        "step": 3,
        "name": "Medium priority",
        "sources": ["contract_templates", "consumer_protection", "real_estate_law"],
        "reason": "Специфичные кейсы"
      },
      {
        "step": 4,
        "name": "Low priority",
        "sources": ["arbitration_practice"],
        "reason": "Дополнительный контекст"
      }
    ]
  },
