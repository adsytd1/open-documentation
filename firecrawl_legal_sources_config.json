  "implementation_code": {
    "n8n_http_request_example": {
      "node_type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.firecrawl.dev/v2/crawl",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.firecrawlApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.url }}"
            },
            {
              "name": "limit",
              "value": "={{ $json.crawlOptions.limit }}"
            },
            {
              "name": "includePaths",
              "value": "={{ $json.crawlOptions.includePaths }}"
            },
            {
              "name": "scrapeOptions",
              "value": "={{ $json.crawlOptions.scrapeOptions }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    "status_check_loop": {
      "description": "Цикл проверки статуса crawl job",
      "nodes": [
        "Wait (30 seconds)",
        "HTTP Request: GET /v2/crawl/{id}",
        "IF: status === 'completed'",
        "  TRUE → Process Results",
        "  FALSE → Back to Wait"
      ]
    }
  },
