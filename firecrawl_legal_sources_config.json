  "troubleshooting": {
    "zakon_kz_specific": {
      "issue": "Сайт блокирует частые запросы",
      "solution": {
        "use_proxy": true,
        "proxy_type": "auto",
        "add_delay": 2,
        "scrapeOptions": {
          "waitFor": 3000,
          "proxy": "auto"
        }
      }
    },
    "pdf_parsing_issues": {
      "issue": "PDF плохо парсится",
      "solutions": [
        {
          "method": "Increase maxPages",
          "params": {
            "parsers": [{"type": "pdf", "maxPages": 2000}]
          }
        },
        {
          "method": "Use OCR fallback",
          "note": "Если PDF - скан, используйте Google Script OCR"
        }
      ]
    },
    "incomplete_content": {
      "issue": "Не весь контент извлекается",
      "solution": {
        "onlyMainContent": false,
        "includeTags": [
          "div.document",
          "div.content", 
          "div.law-text",
          "article",
          "section",
          "p",
          "table"
        ]
      }
    }
  },
  "n8n_workflow_snippets": {
    "firecrawl_crawl_with_status_check": {
      "nodes": [
        {
          "name": "Start Crawl",
          "code": {
            "url": "https://api.firecrawl.dev/v2/crawl",
            "method": "POST",
            "body": {
              "url": "={{ $json.url }}",
              "limit": "={{ $json.limit }}",
              "scrapeOptions": "={{ $json.scrapeOptions }}"
            }
          },
          "output": "{ id: 'crawl-id-123', url: 'status-url' }"
        },
        {
          "name": "Wait Loop",
          "code": "wait 30 seconds → check status → repeat until completed"
        },
        {
          "name": "Check Status",
          "code": {
            "url": "=https://api.firecrawl.dev/v2/crawl/{{ $json.id }}",
            "method": "GET"
          },
          "output": "{ status: 'scraping|completed|failed', data: [...] }"
        },
        {
          "name": "Process Results",
          "code": "if status === 'completed' → extract data → chunk → vectorize → store"
        }
      ]
    },
    "vector_search_in_postgres": {
      "node": "Postgres",
      "operation": "executeQuery",
      "query": "SELECT \n  id,\n  content,\n  category,\n  title,\n  1 - (embedding <=> $1::vector) as similarity\nFROM legal_knowledge\nWHERE 1 - (embedding <=> $1::vector) > 0.7\nORDER BY embedding <=> $1::vector\nLIMIT 10;",
      "parameters": [
        "={{ $json.embedding }}"
      ]
    },
    "batch_embedding_creation": {
      "description": "Создание эмбеддингов батчами для экономии",
      "nodes": [
        "Split In Batches (batch size: 20)",
        "→ OpenAI Embeddings",
        "→ Postgres Insert (batch)",
        "→ Loop back"
      ]
    }
  },
