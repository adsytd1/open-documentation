          "schema": {
            "type": "object",
            "properties": {
              "articles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "article_number": {"type": "integer"},
                    "article_title": {"type": "string"},
                    "article_text": {"type": "string"},
                    "notes": {"type": "string"},
                    "related_articles": {
                      "type": "array",
